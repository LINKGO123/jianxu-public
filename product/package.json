{
  "name": "jianxu-local-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/index.js",
    "check:static": "node scripts/check-static.mjs",
    "predev:client": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:vpn": "node --import tsx --test tests/deepseek-proxy.test.ts tests/qwen-image.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.13",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "pinyin-pro": "3.29.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "6.2.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
